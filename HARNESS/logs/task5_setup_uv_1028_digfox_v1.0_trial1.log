const fs = require("node:fs");
const vm = require("node:vm");

const bundle = fs.readFileSync("dist/save-cache/index.cjs", "utf8");
const start = bundle.indexOf("var ReserveCacheError = class");
if (start === -1) {
  console.log("FAILURE: ReserveCacheError declaration not found in bundle");
  process.exit(1);
}
const end = bundle.indexOf("\n};", start);
const decl = bundle.slice(start, end + 3);

const sandbox = {
  __defProp: Object.defineProperty,
  __name: (target, value) =>
    Object.defineProperty(target, "name", { configurable: true, value }),
};
const ReserveCacheError = vm.runInNewContext(
  decl + "; ReserveCacheError",
  sandbox,
);
const instance = new ReserveCacheError("Unable to reserve cache");

console.log("Class name:", ReserveCacheError.name);
console.log("Instance name:", instance.name);
if (instance.name !== ReserveCacheError.name) {
  console.log(
    "FAILURE REPRODUCED: Class name is " +
      ReserveCacheError.name +
      ", instance name is " +
      instance.name,
  );
  process.exit(1);
} else {
  console.log(
    "SUCCESS: Class name matches instance name (" + instance.name + ")",
  );
  process.exit(0);
}
