import json
from pydantic import BaseModel, ConfigDict, Field

class M(BaseModel):
    model_config = ConfigDict(extra='allow')
    x: int = Field(alias='X', serialization_alias='SX')

m = M.model_validate({'X': 1, 'x': 2, 'SX': 3, 'other': 4})
assert m.model_dump() == {'x': 1, 'SX': 3, 'other': 4}
assert m.model_dump(by_alias=True) == {'SX': 1, 'x': 2, 'other': 4}
assert json.loads(m.model_dump_json()) == {'x': 1, 'SX': 3, 'other': 4}
assert json.loads(m.model_dump_json(by_alias=True)) == {'SX': 1, 'x': 2, 'other': 4}
assert m.model_extra == {'x': 2, 'SX': 3, 'other': 4}

class ConfigAlias(BaseModel):
    model_config = ConfigDict(extra='allow', serialize_by_alias=True)
    x: int = Field(alias='X')

m2 = ConfigAlias.model_validate({'X': 1, 'x': 2})
assert m2.model_dump() == {'X': 1, 'x': 2}
assert json.loads(m2.model_dump_json()) == {'X': 1, 'x': 2}
print('focused collision checks passed')
