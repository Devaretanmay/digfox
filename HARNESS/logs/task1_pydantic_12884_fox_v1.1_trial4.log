import json
from pydantic import BaseModel, ConfigDict, Field

class Inner(BaseModel):
    model_config = ConfigDict(extra='allow')
    x: int = Field(alias='X', serialization_alias='S')
class Outer(BaseModel):
    inner: Inner
    items: list[Inner]

plain = Outer(inner={'X': 1, 'x': 2}, items=[{'X': 3, 'x': 4}])
assert plain.model_dump() == {'inner': {'x': 1}, 'items': [{'x': 3}]}
assert plain.model_dump_json().count('\"x\"') == 2
assert json.loads(plain.model_dump_json(indent=2)) == {'inner': {'x': 1}, 'items': [{'x': 3}]}

aliased = Inner.model_validate({'X': 1, 'S': 2, 'other': 3})
assert aliased.model_dump(by_alias=True) == {'S': 1, 'other': 3}
assert aliased.model_dump(by_alias=False) == {'x': 1, 'S': 2, 'other': 3}
assert aliased.model_extra == {'S': 2, 'other': 3}
assert aliased.model_dump(by_alias=True, exclude={'x'}) == {'S': 2, 'other': 3}

class Excluded(BaseModel):
    model_config = ConfigDict(extra='allow')
    x: int = Field(alias='X', exclude=True)
assert Excluded.model_validate({'X': 1, 'x': 2}).model_dump() == {'x': 2}

class OptionalDefault(BaseModel):
    model_config = ConfigDict(extra='allow')
    x: int | None = Field(None, alias='X')
assert OptionalDefault.model_validate({'X': None, 'x': 2}).model_dump(exclude_none=True) == {'x': 2}
assert OptionalDefault.model_validate({'X': None, 'x': 2}).model_dump(exclude_defaults=True) == {'x': 2}
print('edge checks passed')
