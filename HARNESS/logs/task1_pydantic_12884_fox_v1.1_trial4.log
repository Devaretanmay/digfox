+def _serialized_field_keys(model: BaseModel, by_alias: bool | None) -> set[str]:
+    """Return the keys used for declared fields by the core serializer."""
+    use_alias = model.model_config.get('serialize_by_alias', False) if by_alias is None else by_alias
+    if use_alias:
+        return {field.serialization_alias or name for name, field in model.__pydantic_fields__.items()}
+    return set(model.__pydantic_fields__)
+
+
+def _has_extra_serialization_collision(value: Any, by_alias: bool | None, seen: set[int]) -> bool:
+    """Check a model graph for extras that collide with serialized field keys."""
+    value_id = id(value)
+    if value_id in seen:
+        return False
+
+    if isinstance(value, BaseModel):
+        seen.add(value_id)
+        extra = value.__pydantic_extra__
+        if extra and _serialized_field_keys(value, by_alias).intersection(extra):
+            return True
+        return any(_has_extra_serialization_collision(item, by_alias, seen) for item in value.__dict__.values()) or (
+            extra is not None
+            and any(_has_extra_serialization_collision(item, by_alias, seen) for item in extra.values())
+        )
+
+    if isinstance(value, Mapping):
+        seen.add(value_id)
+        return any(_has_extra_serialization_collision(item, by_alias, seen) for item in value.values())
+    if isinstance(value, (list, tuple, set, frozenset)):
+        seen.add(value_id)
+        return any(_has_extra_serialization_collision(item, by_alias, seen) for item in value)
+    return False
+
+
+def _copy_without_extra_serialization_collisions(value: Any, by_alias: bool | None, memo: dict[int, Any]) -> Any:
+    """Copy a model graph, omitting extras that would overwrite declared fields."""
+    value_id = id(value)
+    if value_id in memo:
+        return memo[value_id]
+
+    if isinstance(value, BaseModel):
+        copied = value.__copy__()
+        memo[value_id] = copied
+        copied.__dict__ = {
+            key: _copy_without_extra_serialization_collisions(item, by_alias, memo)
+            for key, item in value.__dict__.items()
+        }
+        if value.__pydantic_extra__ is not None:
+            field_keys = _serialized_field_keys(value, by_alias)
+            copied.__pydantic_extra__ = {
+                key: _copy_without_extra_serialization_collisions(item, by_alias, memo)
+                for key, item in value.__pydantic_extra__.items()
+                if key not in field_keys
+            }
+        return copied
+
+    if isinstance(value, dict):
+        copied_dict: dict[Any, Any] = {}
+        memo[value_id] = copied_dict
+        copied_dict.update(
+            (key, _copy_without_extra_serialization_collisions(item, by_alias, memo))
+            for key, item in value.items()
+        )
+        return copied_dict
+    if isinstance(value, list):
+        copied_list: list[Any] = []
+        memo[value_id] = copied_list
+        copied_list.extend(_copy_without_extra_serialization_collisions(item, by_alias, memo) for item in value)
+        return copied_list
+    if isinstance(value, tuple):
+        copied_tuple = tuple(_copy_without_extra_serialization_collisions(item, by_alias, memo) for item in value)
+        memo[value_id] = copied_tuple
+        return copied_tuple
+    if isinstance(value, set):
+        copied_set = {_copy_without_extra_serialization_collisions(item, by_alias, memo) for item in value}
+        memo[value_id] = copied_set
+        return copied_set
+    if isinstance(value, frozenset):
+        copied_frozenset = frozenset(
+            _copy_without_extra_serialization_collisions(item, by_alias, memo) for item in value
+        )
+        memo[value_id] = copied_frozenset
+        return copied_frozenset
+    return value
+
+
+def _model_without_extra_serialization_collisions(model: BaseModel, by_alias: bool | None) -> BaseModel:
+    if not _has_extra_serialization_collision(model, by_alias, set()):
+        return model
+    return _copy_without_extra_serialization_collisions(model, by_alias, {})
+
+
