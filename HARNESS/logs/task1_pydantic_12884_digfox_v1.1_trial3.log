import json
from pydantic import BaseModel, ConfigDict, Field

class Child(BaseModel):
    model_config = ConfigDict(extra='allow')
    x: int = Field(alias='X', serialization_alias='serialized_x')

class Parent(BaseModel):
    child: Child
    children: list[Child]

child = Child.model_validate({'X': 1, 'x': 2})
parent = Parent(child=child, children=[child])
assert parent.model_dump() == {'child': {'x': 1}, 'children': [{'x': 1}]}
assert json.loads(parent.model_dump_json()) == {'child': {'x': 1}, 'children': [{'x': 1}]}
assert parent.model_dump(by_alias=True) == {
    'child': {'serialized_x': 1, 'x': 2},
    'children': [{'serialized_x': 1, 'x': 2}],
}
alias_collision = Child.model_validate({'X': 1, 'serialized_x': 3})
assert alias_collision.model_dump(by_alias=True) == {'serialized_x': 1}
assert json.loads(alias_collision.model_dump_json(by_alias=True)) == {'serialized_x': 1}
assert child.model_extra == {'x': 2}
assert parent.child is child and parent.children[0] is child
print('nested, alias, JSON, and non-mutation checks passed')
