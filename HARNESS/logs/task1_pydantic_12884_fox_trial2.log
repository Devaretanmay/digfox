import sys
import json
from pydantic import BaseModel, ConfigDict, Field


class CollisionModel(BaseModel):
    model_config = ConfigDict(extra='allow')
    x: int = Field(alias='X')


payload = {'X': 1, 'x': 2}
model = CollisionModel.model_validate(payload)
dumped = model.model_dump()
json_dumped = json.loads(model.model_dump_json())
print('model.x =', model.x)
print('model.model_extra =', model.model_extra)
print('model.model_dump() =', dumped)
print('model.model_dump_json() =', json_dumped)

if dumped.get('x') == 2 or json_dumped.get('x') == 2:
    print('FAILURE REPRODUCED: model.x overwritten by extra field value 2')
    sys.exit(1)
elif dumped.get('x') == 1 and json_dumped.get('x') == 1:
    print('SUCCESS: model.x preserved with validated value 1')
    sys.exit(0)
else:
    print('UNEXPECTED OUTPUT:', dumped)
    sys.exit(2)

