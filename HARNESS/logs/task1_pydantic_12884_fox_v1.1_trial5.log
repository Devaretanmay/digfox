import json
from pydantic import BaseModel, ConfigDict, Field, field_serializer

class Model(BaseModel):
    model_config = ConfigDict(extra='allow')
    x: int = Field(alias='X')
    @field_serializer('x')
    def serialize_x(self, value):
        return f'v={value}'

for config_alias in (False, True):
    Model.model_config['serialize_by_alias'] = config_alias
    Model.model_rebuild(force=True)
    m = Model.model_validate({'X': 1, 'x': 2})
    print('config', config_alias, m.model_dump(), json.loads(m.model_dump_json()))
    print('explicit false', m.model_dump(by_alias=False), json.loads(m.model_dump_json(by_alias=False)))
    print('explicit true', m.model_dump(by_alias=True), json.loads(m.model_dump_json(by_alias=True)))
    print('state', m.x, m.model_extra)

class Child(BaseModel):
    model_config = ConfigDict(extra='allow')
    x: int = Field(alias='X')
class Parent(BaseModel):
    child: Child
p = Parent(child=Child.model_validate({'X': 1, 'x': 2}))
print('nested', p.model_dump(), json.loads(p.model_dump_json()))
