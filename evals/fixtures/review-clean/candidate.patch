diff --git a/paging.py b/paging.py
--- a/paging.py
+++ b/paging.py
@@ -1,4 +1,6 @@
-def page(items, limit=50):
+def page(items, limit=50, offset=0):
     if not 1 <= limit <= 100:
         raise ValueError("limit must be between 1 and 100")
-    return items[:limit]
+    if not isinstance(offset, int) or isinstance(offset, bool) or offset < 0:
+        raise ValueError("offset must be a non-negative integer")
+    return items[offset:offset + limit]
diff --git a/test_paging.py b/test_paging.py
--- a/test_paging.py
+++ b/test_paging.py
@@ -11,6 +11,14 @@ class PagingTests(unittest.TestCase):
         with self.assertRaises(ValueError):
             page([1, 2, 3], limit=0)
 
+    def test_offset_is_applied_before_limit(self):
+        self.assertEqual(page([1, 2, 3, 4], limit=2, offset=1), [2, 3])
+
+    def test_invalid_offset(self):
+        for value in (-1, 1.5, True):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                page([1, 2, 3], offset=value)
+
 
 if __name__ == "__main__":
     unittest.main()
